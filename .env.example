# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit it.

# ===== Flask =====
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=teacher_part

# ===== File uploads =====
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10

# ===== NLP models =====
TROCR_MODEL=microsoft/trocr-base-handwritten
LLM_MODEL=google/flan-t5-base
GRADER_BASE_MODEL=sentence-transformers/paraphrase-MiniLM-L6-v2
GRADER_FINETUNED_PATH=models/sbert-grading-finetuned

# ===== OCR threshold =====
OCR_MIN_CONFIDENCE=0.40